# ---------------------------------------------------------------------------
# Migration credentials — fill these in, then rename this file to `.env`
# NEVER commit the filled-in .env to git.
# ---------------------------------------------------------------------------

# SOURCE (old) Supabase project
# Get the DB connection string from: Dashboard -> Project Settings -> Database
# -> Connection string -> URI (use the "Session"/direct connection, port 5432,
# NOT the pooler on 6543 — pg_dump needs the direct connection).
SOURCE_DB_URL="postgresql://postgres:PASSWORD@db.OLD_REF.supabase.co:5432/postgres"
SOURCE_SUPABASE_URL="https://OLD_REF.supabase.co"
SOURCE_SERVICE_ROLE_KEY="OLD_service_role_key"

# TARGET (new) Supabase project
TARGET_DB_URL="postgresql://postgres:PASSWORD@db.NEW_REF.supabase.co:5432/postgres"
TARGET_SUPABASE_URL="https://NEW_REF.supabase.co"
TARGET_SERVICE_ROLE_KEY="NEW_service_role_key"
